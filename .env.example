# PayTrack Frontend Environment Variables
# Copy to .env.local and fill in values

# Backend API URL
VITE_API_URL=http://localhost:3001/api/v1

# Stellar Explorer base URL
VITE_STELLAR_EXPLORER_TESTNET=https://stellar.expert/explorer/testnet
VITE_STELLAR_EXPLORER_MAINNET=https://stellar.expert/explorer/public

# App metadata
VITE_APP_NAME=PayTrack
VITE_APP_VERSION=1.0.0
